{
  "name": "ramify.ts",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-file hierarchical modules for TypeScript: a toolkit to define, enforce, visualize, and help agents adhere to them.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "diagrams": "tsx scripts/emit-diagrams.ts",
    "site:dev": "npm --prefix site run start -- --port 4300",
    "site:build": "npm --prefix site run build",
    "site:serve": "npm --prefix site run serve -- --port 4301",
    "example:install": "npm --prefix examples/collection-review install",
    "example:dev:api": "npm --prefix examples/collection-review run dev:api",
    "example:dev:web": "npm --prefix examples/collection-review run dev:web",
    "example:build": "npm --prefix examples/collection-review run build",
    "example:type-check": "npm --prefix examples/collection-review run type-check",
    "example:test": "npm --prefix examples/collection-review run test",
    "example:test:cucumber": "npm --prefix examples/collection-review run test:cucumber",
    "reference:cases": "vitest run -c scripts/reference-harness/vitest.config.ts",
    "reference:report": "tsx scripts/reference-harness/report.ts"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "d3-shape": "^3.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
