{
  "name": "ramify.ts",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-file hierarchical modules for TypeScript: a toolkit to define, enforce, visualize, and help agents adhere to them.",
  "type": "module",
  "bin": {
    "ramify": "dist/src/ramify"
  },
  "exports": {
    ".": {
      "types": "./dist/subs/analysis/src/index.d.ts",
      "import": "./dist/subs/analysis/src/index.js"
    },
    "./analysis": {
      "types": "./dist/subs/analysis/src/index.d.ts",
      "import": "./dist/subs/analysis/src/index.js"
    },
    "./analysis/inventory": {
      "types": "./dist/subs/analysis/src/inventory-entry.d.ts",
      "import": "./dist/subs/analysis/src/inventory-entry.js"
    },
    "./model": {
      "types": "./dist/subs/analysis/subs/model/src/index.d.ts",
      "import": "./dist/subs/analysis/subs/model/src/index.js"
    },
    "./presentation": {
      "types": "./dist/subs/presentation/src/index.d.ts",
      "import": "./dist/subs/presentation/src/index.js"
    },
    "./module-tree": {
      "types": "./dist/subs/presentation/src/module-tree-entry.d.ts",
      "import": "./dist/subs/presentation/src/module-tree-entry.js"
    },
    "./module-tree.css": "./dist/subs/presentation/src/module-tree-entry.css",
    "./cli": {
      "types": "./dist/subs/cli/src/index.d.ts",
      "import": "./dist/subs/cli/src/index.js"
    },
    "./layout": {
      "types": "./dist/subs/presentation/subs/layout/src/index.d.ts",
      "import": "./dist/subs/presentation/subs/layout/src/index.js"
    },
    "./client": {
      "types": "./dist/subs/daemon/src/client-entry.d.ts",
      "import": "./dist/subs/daemon/src/client-entry.js"
    }
  },
  "scripts": {
    "worktree:prepare": "npm --prefix examples/collection-review ci && npm --prefix site ci && npm --prefix ramify-agent ci",
    "build": "tsx scripts/build-production.ts && npm run explorer:build",
    "explorer:build": "vite build --config vite.explorer.config.ts",
    "explorer:dev": "vite --config vite.explorer.config.ts",
    "production:files": "tsx scripts/production-files.ts",
    "dev": "tsc --noEmit --watch",
    "type-check": "tsc --noEmit && tsc -p tsconfig.portable.json && tsc -p tsconfig.scripts.json && tsc -p scripts/reference-harness/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "diagrams": "tsx scripts/emit-diagrams.ts",
    "site:dev": "npm --prefix site run start -- --port 4300",
    "site:build": "npm --prefix site run build",
    "site:serve": "npm --prefix site run serve -- --port 4301",
    "example:install": "npm --prefix examples/collection-review install",
    "example:dev:api": "npm --prefix examples/collection-review run dev:api",
    "example:dev:web": "npm --prefix examples/collection-review run dev:web",
    "example:build": "npm --prefix examples/collection-review run build",
    "example:type-check": "npm --prefix examples/collection-review run type-check",
    "example:test": "npm --prefix examples/collection-review run test",
    "example:test:cucumber": "npm --prefix examples/collection-review run test:cucumber",
    "reference:cases": "vitest run -c scripts/reference-harness/vitest.config.ts",
    "reference:report": "tsx scripts/reference-harness/report.ts",
    "check:reference": "dist/src/ramify check --root examples/collection-review",
    "check:self": "dist/src/ramify check --root .",
    "measure:batch": "node scripts/measurements/run.mjs",
    "measure:resident": "node scripts/measurements/resident.mjs",
    "measure:fast": "node scripts/measurements/fast.mjs",
    "probe:modularity": "tsx scripts/probes/modularity/baseline.ts",
    "measure:plan2a": "node --import tsx scripts/measurements/plan2a.mjs",
    "measure:plan2a-platform": "node --import tsx scripts/measurements/plan2a-platform.mjs",
    "measure:plan2b": "node --import tsx scripts/measurements/plan2b.mjs",
    "measure:plan2c": "node --import tsx scripts/measurements/plan2c.mjs",
    "measure:project-explorer": "tsx subs/integration-tests/src/browser-acceptance.ts",
    "reference:verify": "tsx scripts/reference-harness/verify.ts"
  },
  "devDependencies": {
    "@streamparser/json": "0.0.26",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "bun": "1.4.2",
    "jsdom": "^30.0.1",
    "playwright-core": "1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@xyflow/react": "^12.10.0",
    "d3-hierarchy": "^3.1.2",
    "d3-shape": "^3.2.0",
    "express": "^5.2.1",
    "typescript": "7.0.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "main": "./dist/subs/analysis/src/index.js",
  "types": "./dist/subs/analysis/src/index.d.ts"
}
