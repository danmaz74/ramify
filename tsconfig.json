{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": true,
    "skipLibCheck": true,
    // Whole-project checking includes Node owners and all owned tests.
    // Portable owners also pass the separate tsconfig.portable.json check.
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "subs/**/src/**/*"],
  "exclude": ["node_modules", "dist", "site", "examples", "scripts", "**/.reference-work"]
}
