{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    // No ambient Node types under src/: everything there must be browser-safe.
    // The one file that needs them (scripts/emit-diagrams.ts) is type-checked
    // by tsconfig.scripts.json instead.
    "types": [],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
