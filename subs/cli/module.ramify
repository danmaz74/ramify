ramify 1
module cli tagged [dispatch]

expose-src runCli from "run-cli.ts" to parent
expose-src * from "interfaces/cli.ts" to parent
// The resident explorer server opens the same context setup as `ramify explore`.
expose-src capabilities from "command-support.ts" to parent

expose-src ownershipDocumentSchema from "ownership-schema.ts" to parent
expose-test checkDocumentSchema, cliFailureDocumentSchema from "response-schema.ts" to parent
