ramify 1
// The browser shell. It also relays: feature adapters travel through it to the
// root, and shared vocabulary travels through it down to every descendant and
// up to the root, whose assembly names it through the inspection port.
module workspace tagged [ui, browser, dispatch]

expose-sub * from contracts to parent, descendants

// The catalog's finished API surfaces, on their way to the root that mounts
// them, with the procedure record the router's declared type names. This shell
// cannot value-import them itself; relaying is a declaration, not an import.
expose-sub createCatalogRouter, CatalogProcedures, createCatalogTools, inspectRecord from catalog to parent

// The review feature's finished API surfaces, with the procedure record the
// router's declared type names, and the port its factories take so the root
// can build one out of the catalog's inspection.
expose-sub createReviewsRouter, ReviewsProcedures, createReviewsTools, InspectionPort from reviews to parent

// The catalog's test fixture, for the tests of every other owner beneath this
// one. Their ordinary source cannot import it: the fixture is tagged
// `testing`.
expose-sub makeCatalogFixture, CatalogFixtureRecord from catalog to descendants

// The shared presentation primitives, down to every descendant. Both feature
// views take them; their core siblings see them and cannot import them,
// because no core source carries `ui`.
expose-sub * from shared-ui to descendants
