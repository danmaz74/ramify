ramify 1
// The application root: the Node entry, the configured protocol runtimes, and
// the assembly that mounts the adapters its descendants relay upward.
module collection-review tagged [dispatch]

// The neutral protocol vocabulary a feature needs to build an adapter, with the
// schema and result shapes a tool contribution's signature names. It reaches
// every descendant, but only dispatch-classified source can import it: the core
// owners and the pure view carry no `dispatch`.
expose-src InvocationContext, ProtocolFacilities, McpToolContribution, ToolInvocation, ToolInputSchema, ToolResult from "interfaces/protocol.ts" to descendants

// The configured system itself, for any owner's tests, with the shapes its
// signature names. They are new testing-owned bindings, so they carry this
// owner's test profile and no production source anywhere can import them.
expose-test createTestSystem, TestSystem, McpSession from "setup.ts" to descendants

// The application router's type, for the shell that builds a client from it
// and the connected view that names that client. It is a same-owner alias of
// the assembly's own type, and the router's type is inferred from
// `assembleRouter`, which therefore travels with it; the rest of `assembly.ts`
// stays private. Both carry this owner's `dispatch` tag and no browser
// promise: the core owners and the pure view see them and can import them in
// neither form, and the two owners that can import them do so as types.
expose-src AppRouter, assembleRouter from "interfaces/protocol.ts" to descendants
