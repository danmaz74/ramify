{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "subs/**/src/**/*",
    "scripts/**/*",
    // Presentation's static diagram emitter, presentation-owned source outside its src/.
    "subs/presentation/scripts/**/*",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "site", "examples", "**/.reference-work",
    // An independent package consumer with its own manifest, compiler scope and React.
    "scripts/reference-harness/fixtures/module-tree-consumer"]
}
