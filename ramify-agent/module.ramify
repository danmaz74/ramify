ramify 1
module "ramify-agent"

// The harness owns the formats it implements and exposes them here. This
// module re-exposes exactly that public contract surface to every descendant,
// so the web client validates what crosses the wire with the same schemas.
// Starting a server and its lock failures stay with the root.

// protocol/evidence.ts
expose-sub Citation, InputManifest, ModulePath from harness to descendants
expose-sub ModuleTree, ModuleTreeResponse, TreeModule from harness to descendants
expose-sub ViewIdentity, citationSchema, inputManifestSchema from harness to descendants
expose-sub isWithin, modulePathSchema, moduleTreeResponseSchema from harness to descendants
expose-sub sha256Schema, treeModuleSchema, viewIdentitySchema from harness to descendants

// protocol/ids.ts
expose-sub JobId, PlanId, jobIdSchema, planIdSchema from harness to descendants

// protocol/queries.ts
expose-sub PlanDocument, PlanEntry, PlanListResponse from harness to descendants
expose-sub PlanResponse, ProjectResponse, ReadablePlanEntry from harness to descendants
expose-sub UnreadablePlanEntry, planEntrySchema from harness to descendants
expose-sub planListResponseSchema, planResponseSchema from harness to descendants
expose-sub projectResponseSchema, readablePlanEntrySchema from harness to descendants
expose-sub unreadablePlanEntrySchema from harness to descendants
expose-sub planDecisionWaitSchema, PlanDecisionWait from harness to descendants

// protocol/errors.ts
expose-sub ErrorCode, ErrorResponse, errorCodeSchema from harness to descendants
expose-sub errorHttpStatus, errorResponseSchema from harness to descendants

// protocol/jobs.ts
expose-sub AcceptedCommand, Activity, ApiViewEvidence from harness to descendants
expose-sub CommandResponse, JobState, Receipt, Usage from harness to descendants
expose-sub acceptedCommandSchema, activitySchema from harness to descendants
expose-sub apiViewEvidenceSchema, commandIdSchema from harness to descendants
expose-sub commandResponseSchema, jobStateSchema from harness to descendants
expose-sub jobVersionSchema, receiptSchema, stopJobCommandSchema from harness to descendants
expose-sub usageSchema from harness to descendants

// protocol/paths.ts
expose-sub apiPrefix, protocolPaths, CheckFindingPathQuery from harness to descendants

