{
  "ignorePaths": ["docs/**"],
  "checks": [
    {
      "id": "patch-integrity",
      "name": "Committed patch integrity",
      "description": "Reject whitespace errors in the committed patch",
      "scope": "both",
      "category": "deterministic",
      "executor": {
        "kind": "command",
        "commands": [
          {
            "name": "git-diff-check",
            "cmd": "git",
            "args": [
              "diff",
              "--check",
              "HEAD^",
              "HEAD"
            ],
            "parser": "none",
            "timeoutMs": 30000
          }
        ],
        "continueOnFailure": true
      },
      "onFailure": "record"
    },
    {
      "id": "agent-typecheck",
      "name": "Ramify agent type checks",
      "description": "Type-check the harness, web package and scripts",
      "scope": "both",
      "category": "deterministic",
      "executor": {
        "kind": "command",
        "commands": [
          {
            "name": "agent-typecheck",
            "cmd": "npm",
            "args": [
              "run",
              "type-check"
            ],
            "parser": "none",
            "timeoutMs": 180000
          }
        ],
        "continueOnFailure": true
      },
      "onFailure": "record",
      "dependsOn": [
        "patch-integrity"
      ]
    },
    {
      "id": "agent-tests",
      "name": "Ramify agent regression suite",
      "description": "Run the complete four-worker Ramify agent suite",
      "scope": "both",
      "category": "deterministic",
      "executor": {
        "kind": "command",
        "commands": [
          {
            "name": "agent-vitest",
            "cmd": "npm",
            "args": [
              "test",
              "--",
              "--maxWorkers=4"
            ],
            "parser": "vitest",
            "timeoutMs": 1200000
          }
        ],
        "continueOnFailure": true
      },
      "onFailure": "record",
      "dependsOn": [
        "agent-typecheck"
      ]
    },
    {
      "id": "agent-structure",
      "name": "Ramify agent structural check",
      "description": "Run the agent package's batch Ramify self-check",
      "scope": "both",
      "category": "deterministic",
      "executor": {
        "kind": "command",
        "commands": [
          {
            "name": "agent-check-self",
            "cmd": "npm",
            "args": [
              "run",
              "check:self"
            ],
            "parser": "none",
            "timeoutMs": 180000
          }
        ],
        "continueOnFailure": true
      },
      "onFailure": "record",
      "dependsOn": [
        "agent-typecheck"
      ]
    },
    {
      "id": "agent-web-build",
      "name": "Ramify agent web production build",
      "description": "Build the web consumer of harness projections",
      "scope": "both",
      "category": "deterministic",
      "executor": {
        "kind": "command",
        "commands": [
          {
            "name": "agent-web-build",
            "cmd": "npm",
            "args": [
              "run",
              "build:web"
            ],
            "parser": "none",
            "timeoutMs": 180000
          }
        ],
        "continueOnFailure": true
      },
      "onFailure": "record",
      "dependsOn": [
        "agent-typecheck"
      ]
    }
  ]
}
