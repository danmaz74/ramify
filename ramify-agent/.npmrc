# The package registry, a proxy. ramify-audit is pinned to a GitHub commit
# until 0.1.1 is published here; see subs/harness/subs/audit/README.md.
registry=https://npm.braimax.com/

# npm 10.9's peer-set resolver crashes on a fresh vitest 4 install
# ("Cannot read properties of null (reading 'edgesOut')"). Skipping peer-set
# resolution avoids it; vite, vitest's peer, is declared explicitly instead.
legacy-peer-deps=true
