ramify 1
// The application root: the Node entry, the configured protocol runtimes, and
// the assembly that mounts the adapters its descendants relay upward.
root module collection-review tagged [dispatch]

// The neutral protocol vocabulary a feature needs to build an adapter. It
// reaches every descendant, but only dispatch-classified source can import it:
// the core owners and the pure view carry no `dispatch`.
expose-src InvocationContext, ProtocolFacilities, McpToolContribution, ToolInvocation, ToolInputSchema, ToolResult from "interfaces/protocol.ts" to descendants
expose-src createFacilities from "protocol.ts" to descendants

// The configured system itself, for any owner's tests, in process or served
// by the real listener on a loopback port. It is a new testing-owned binding,
// so it carries this owner's test profile and no production source anywhere
// can import it.
expose-test createTestSystem, TestSystem, McpSession from "setup.ts" to descendants
expose-test startServedTestSystem, ServedTestSystem from "setup.ts" to descendants

// The application router's type, for the shell that builds a client from it
// and the connected view that names that client. It is a same-owner alias of
// the assembly's own type. The assembly names below are its signature
// companions. They carry this owner's `dispatch` tag and no browser promise:
// the core owners and the pure view see them and can import them in neither
// form, and the two owners that use the router do so as a type.
expose-src AppRouter from "interfaces/protocol.ts" to descendants
expose-src AssembledSystem, assembleRouter, ProtocolRuntime from "assembly.ts" to descendants
