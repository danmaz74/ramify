ramify 1
// `ui` is a reserved keyword, so the declared name is quoted. The module
// identifier remains catalog/ui.
module "ui" tagged [ui, browser]

// The card, for the feature parent to relay up to the shell, with the props
// type its signature names. The shell supplies a summary it obtained from the
// API.
expose-src CatalogCard, CatalogCardProps from "catalog-card.tsx" tagged [ui, browser] to parent
