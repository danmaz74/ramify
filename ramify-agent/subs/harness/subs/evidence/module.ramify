ramify 1
module evidence

// Running the Ramify CLI: its exit codes and the private daemon stay here.
// The executable's own path crosses, because a run captures the complete
// command it ran the Ramify check with, environment included, and a captured
// command that names no executable cannot be run again.
expose-src RamifyCli, RamifyRun, RamifyCheckResult, MaterializeResult, ramifyVersion, privateRamify, ramifyExecutable from "ramify-cli.ts" to parent

// Reading what Ramify generates: the architect view, a requester API view and
// the measurement document. Their file formats stay here.
expose-src architectViewDirectory, ArchitectMeta, readArchitectMeta, coverageLimitsOf, ArchitectIndex, loadArchitectIndex, loadModuleTree from "views.ts" to parent
expose-src ModuleEntry, SymbolRecord, ExposureChannel, findModule, symbolRecords, SourceArea, ApiViewSnapshot, readApiView, findInView from "views.ts" to parent
expose-src isTestingModule from "views.ts" to parent
expose-src MeasurementDocument, ModuleMeasurement, MeasurementRead, readMeasurement, documentSchema, moduleSchema from "measure.ts" to parent

// Running one of the target project's own commands, in its own process group
// and with a clean environment.
expose-src CommandRunner, runCommand, CommandRequest, CommandRun, CommandOutcome, CommandOutput, childEnvironment, environmentNames, outputTailBytes from "run-command.ts" to parent

// The target project's configuration for the harness, read as bytes; its
// schema and what an invalid file means belong to the harness.
expose-src projectConfigurationFile, ProjectConfigurationRead, readProjectConfiguration from "project-configuration.ts" to parent

// The identity of the state the evidence describes.
expose-src guardedFilesHash from "guarded-files.ts" to parent

// Git, for the run branch: a clean-repository check, the branch, the commit a
// gate audits, recovery by exact trailers, and what changed.
expose-src GitError, CommitTrailer, isCleanRepository, createRunBranch, commitAccepted, findCommitByTrailer, findCommitByTrailers, changedPaths, diffNumstat from "git.ts" to parent
expose-src commitNameStatus, diffNameStatus, worktreeLineChanges, worktreePatch, changedEntries from "git.ts" to parent

// A committed candidate read from Git's objects, which a review snapshot is
// served from: its tree, its files, a search and its diff from a base.
expose-src CandidateSource, gitCandidateSource, TreeEntry, TreeMatch, commitTree, treeEntries, readBlob, grepTree, diffPatch from "git.ts" to parent

// Consumers inject this boundary; real Git integration tests live with the adapter.
expose-src GitService, gitService, currentHead, runBranchName from "git.ts" to parent
expose-src CandidateTreePreview, previewCandidateTree from "candidate-tree.ts" to parent
