ramify 1
module scenarios

// Acceptance scenarios as pure functions: plan extraction, the form rules of
// the initial analysis, records and their numbering, the state reducer and
// feature rendering. The project's own Cucumber configuration runs them as
// checks of its committed audit definition. The Gherkin parser stays behind
// this boundary. Every named type a signature mentions is exposed
// beside the symbol, so the parent can name what it receives.
expose-src extractPlanScenarios, extractDocumentScenarios, PlanScenario, planScenarioSchema from "extraction.ts" to parent
expose-src PlanScenarioLimitation, planScenarioLimitationSchema from "extraction.ts" to parent
expose-src PlanScenarioExtraction, planScenarioExtractionSchema from "extraction.ts" to parent

expose-src validateScenarioForm, scenarioFormRules, ScenarioFormRule, ScenarioFormResult from "form.ts" to parent
expose-src ScenarioFormSubmission, scenarioFormSubmissionSchema, ScenarioSubmission, scenarioSubmissionSchema from "form.ts" to parent
expose-src IntegrationScenarioSubmission, integrationScenarioSubmissionSchema, scenarioOriginSubmissionSchema from "form.ts" to parent
expose-src ScenarioElementRef, scenarioElementRefSchema, ScenarioFormEntry, ScenarioViewNames from "form.ts" to parent
expose-src ScenarioWarning, ScenarioWarningKind, AcceptedScenarioForm, FormScenario, FormIntegration from "form.ts" to parent

expose-src assignScenarioIds, AssignedScenarios, ScenarioIdContext, ScenarioModule from "records.ts" to parent
expose-src ScenarioRecord, scenarioRecordSchema, ScenarioId, scenarioIdSchema from "records.ts" to parent
expose-src scenarioSourceHash, scenarioIdOf, lowestCommonAncestor, featureDirectoryOf from "records.ts" to parent

expose-src ScenarioState, scenarioStateSchema, ScenarioEvent, scenarioEventTypes from "states.ts" to parent
expose-src ScenarioStates, initialScenarioStates, applyScenarioEvent, boundState, reportedState from "states.ts" to parent
expose-src reduceScenarioStates, countScenarioStates, carriesPendingTag from "states.ts" to parent

expose-src renderFeatureFiles, FeatureRenderingRun, RenderedFeatureFile from "rendering.ts" to parent
expose-src pendingTag, identityTagOf, scenarioIdOfTag from "rendering.ts" to parent
