ramify 1
module reviews

// Reviewer answers, shared with durable envelopes maintained by harness.
expose-src * from "interfaces/submissions.ts" to parent

// Mechanical preparation of one fixed question: the parent owns invocation lifetime.
expose-src prepareReview, PreparedReview, ReviewPreparation from "preparation.ts" to parent
expose-src reviewMessage, orientationMessage, ReviewBriefing, ReviewIntent, ReviewQuestion, ReviewMessageInputs from "message.ts" to parent
expose-src orientationKey, readGuidance, CapturedInput from "inputs.ts" to parent
expose-src openCandidateSnapshot, resolveSnapshotPath, snapshotTools, snapshotToolDeclarations, SnapshotToolDeclaration, snapshotToolNames, snapshotReadLimits, CandidateSnapshot, CandidateChange, SnapshotComparison, SnapshotTools, SnapshotPath, SnapshotDenial from "snapshot.ts" to parent
expose-src reviewToolName, reviewJsonSchema, reviewSubmissionDescription, orientationToolName, orientationJsonSchema, orientationSubmissionDescription, validateOrientation from "submission.ts" to parent
