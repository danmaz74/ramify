ramify 1
// The connected view. `dispatch` is what lets it name the typed client; the
// declared name is quoted because `ui` is a reserved keyword.
module "ui" tagged [ui, browser, dispatch]

// The connected panel, for the feature parent to relay up to the shell. The
// props type accompanies its signature; the loading function beside it stays
// private, because this owner does not publish a separate way to call the API.
expose-src ReviewPanel, ReviewPanelProps from "review-panel.tsx" tagged [ui, dispatch, browser] to parent
