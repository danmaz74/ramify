# ramify.ts keeps its own ignore list, like the rest of its toolchain.

# Match dependency directories and the symlinks Studio creates in worktrees.
node_modules

# Documentation site: its own npm package, its own build output.
site/build/
site/.docusaurus/

# Build output of the toolkit and the reference example.
dist/

# cucumber-viz state written into the project while Studio runs.
.cucumber-viz/
cucumber-viz.config.local.json
*.viz.feature.meta/

# Reference-harness mutation copies of the example.
examples/collection-review/.reference-work/

# Unique production-build staging directories.
.reference-work/

# Materialized API-view catalogs, the materialized architect view and the
# publisher's reserved transient staging/rollback siblings of each (defense
# against commits and project-wide searches; the generated-path predicate
# that isolates them at every runtime boundary is authoritative, not this
# file). Matches the closed enumeration only, at any depth: `.ramify`,
# `.ramify.tmp-<suffix>`, `.ramify.old-<suffix>`, `.ramify-architect`,
# `.ramify-architect.tmp-<suffix>` and `.ramify-architect.old-<suffix>`.
# Near-miss names such as `.ramify-other`, `.ramify-architects`, `.ramify.tmp`
# or `.ramify-architect.tmp` (no suffix) are ordinary and intentionally left
# tracked.
.ramify/
.ramify.tmp-*/
.ramify.old-*/
.ramify-architect/
.ramify-architect.tmp-*/
.ramify-architect.old-*/

# Host-specific compose interpolation, e.g. RESTART_POLICY on the server.
.devcontainer/.env
